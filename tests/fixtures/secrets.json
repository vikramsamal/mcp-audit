{
  "mcpServers": {
    "server_with_literal_secret": {
      "command": "secret-service",
      "env": {
        "API_KEY": "FAKE_SECRET_LITERAL_VALUE_9999",
        "DATABASE_PASSWORD": "FAKE_DB_LITERAL_PASS_1234"
      }
    },
    "server_with_env_refs": {
      "command": "safe-service",
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}",
        "DB_PASSWORD": "$DATABASE_PASSWORD",
        "AUTH_TOKEN": "%AUTH_TOKEN%",
        "SLACK_BOT_TOKEN": "env:SLACK_BOT_TOKEN"
      }
    },
    "server_with_placeholders": {
      "command": "placeholder-service",
      "env": {
        "API_KEY": "<YOUR_API_KEY_HERE>",
        "AWS_SECRET_ACCESS_KEY": "YOUR_AWS_SECRET_ACCESS_KEY",
        "EMPTY_KEY": ""
      }
    }
  }
}
